          const bar = document.createElement('div');
          bar.style.cssText = 'position:fixed;bottom:0;left:0;right:0;background:#3b82f6;color:#fff;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;z-index:99999;font-family:inherit;font-size:13px;font-weight:600;box-shadow:0 -4px 20px rgba(0,0,0,.3)';
          bar.innerHTML = '<span>Nova versão disponível!</span><button onclick="location.reload()" style="background:#fff;color:#3b82f6;border:none;padding:8px 16px;border-radius:8px;font-weight:700;cursor:pointer;font-family:inherit">Atualizar</button>';
          document.body.appendChild(bar);
        }
      });
      navigator.serviceWorker.register('sw.js').then(reg => {
        setInterval(() => reg.update(), 60000);
      });
    }
